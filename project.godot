; Bulalakaw Station — Godot 4.7.2, GDScript, Compatibility renderer (web export is the main build)
config_version=5

[application]

config/name="Bulalakaw Station"
run/main_scene="res://scenes/Main.tscn"
config/icon="res://icon.png"
boot_splash/image="res://boot_splash.png"
boot_splash/fullsize=true
boot_splash/bg_color=Color(0.333, 0.141, 0.396, 1)
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Balance="*res://autoload/Balance.gd"
Progression="*res://autoload/Progression.gd"
SimState="*res://autoload/SimState.gd"
Assets="*res://autoload/Assets.gd"
Sfx="*res://autoload/Sfx.gd"
DonkiService="*res://autoload/DonkiService.gd"
Game="*res://autoload/Game.gd"

[display]

window/stretch/aspect="keep"

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[input_devices]

pointing/emulate_touch_from_mouse=false

[gui]

theme/custom_font="res://assets/fonts/Silkscreen-Regular.ttf"
theme/default_font_antialiasing=0
theme/default_font_subpixel_positioning=0

[rendering]
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
