[resource]
script = ExtResource("3_pu7i7")
id = 7
title = "The Bulalakaw Night"
theme = "Finale"
briefing_text = "Dust, a solar flare and a radio blackout, all at once! Keep everyone safe and send our discovery to Earth."
debrief_why = "Real missions have to juggle power, air, food and radiation all at the same time."
debrief_tip = "Send important messages early. The radio delay means late messages may never arrive."
did_you_know = "This night combines two real events: the 2018 global dust storm and the May 2024 solar flare."
did_you_know_source = "NASA"
hazard_events = Array[ExtResource("2_nnqfm")]([SubResource("Resource_6tkam"), SubResource("Resource_1b0eo"), SubResource("Resource_jhkla"), SubResource("Resource_exddv"), SubResource("Resource_l7d2o")])
crew_ids = Array[String](["lani", "maya", "mateo", "carlo"])
crew_schedule = Array[ExtResource("1_dq2ml")]([SubResource("Resource_r6gg6"), SubResource("Resource_dw4te"), SubResource("Resource_60tli"), SubResource("Resource_67qkk")])
visible_meters = Array[String](["comms"])
food_enabled = true
unlocked_plots = Array[String](["solar", "battery", "life_support", "greenhouse", "shelter", "suit_bay", "comms_dish"])
bonus_goals = Array[String](["discovery_sent", "shelter_fast", "battery_20"])
comms_delay_real_min = 4.6
