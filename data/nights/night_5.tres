[resource]
script = ExtResource("3_f8dk8")
id = 5
title = "The Big Dust"
theme = "Dust storm"
briefing_text = "A planet-wide dust storm like the real one in 2018 has covered the sky. The panels made less power today."
debrief_why = "Martian dust is very fine and sticky. It blocks sunlight and covers solar panels."
debrief_tip = "On dust nights, start with less: fewer cameras and a lower heater."
did_you_know = "In 2018 a dust storm covered all of Mars for weeks."
did_you_know_source = "NASA"
hazard_events = Array[ExtResource("2_sb0tu")]([SubResource("Resource_pnhq5"), SubResource("Resource_76pwf"), SubResource("Resource_mgvxm"), SubResource("Resource_h5aey")])
crew_ids = Array[String](["lani", "maya", "mateo", "carlo"])
crew_schedule = Array[ExtResource("1_o0ixq")]([SubResource("Resource_8uqwb"), SubResource("Resource_jyf0x"), SubResource("Resource_pk1ee"), SubResource("Resource_uexur"), SubResource("Resource_c63g4")])
visible_meters = Array[String](["comms"])
food_enabled = true
unlocked_plots = Array[String](["solar", "battery", "life_support", "greenhouse", "shelter", "suit_bay", "comms_dish"])
bonus_goals = Array[String](["battery_20", "food_grew", "all_inside_end"])
comms_delay_real_min = 4.6
