[resource]
script = ExtResource("3_t6kr7")
id = 3
title = "Invisible Energy"
comms_delay_real_min = 9.2
theme = "Radiation and shielding"
briefing_text = "Doctor Mateo is here. A real solar storm from September 2017 is coming. Our shelter has thick shielding!"
debrief_why = "Light from a solar flare travels fastest, so it arrives before the particles. That gap is your warning time."
debrief_tip = "When the sky glows: recall anyone outside, open the shelter, then close the door once everyone is in."
did_you_know = "In September 2017, Curiosity's radiation detector measured dose rates on Mars 2 to 3 times higher than normal."
did_you_know_source = "Zeitlin et al. 2018, Geophysical Research Letters (Curiosity RAD)"
hazard_events = Array[ExtResource("2_s4sol")]([SubResource("Resource_a24tn"), SubResource("Resource_upy7v"), SubResource("Resource_ixj3a")])
crew_ids = Array[String](["lani", "maya", "mateo"])
crew_schedule = Array[ExtResource("1_0tj7b")]([SubResource("Resource_tn2o8"), SubResource("Resource_o1djs"), SubResource("Resource_6fhcf"), SubResource("Resource_hljtg")])
visible_meters = Array[String](["dose"])
food_enabled = true
unlocked_plots = Array[String](["solar", "battery", "life_support", "greenhouse", "shelter"])
bonus_goals = Array[String](["shelter_fast", "battery_20", "food_grew"])
codex_unlocks = Array[String](["radiation", "solar_flare", "shelter_shielding"])
