[gd_resource type="Resource" script_class="NightConfig" format=3]

[ext_resource type="Script" path="res://resources/CrewSchedule.gd" id="1_fmegu"]
[ext_resource type="Script" path="res://resources/HazardEvent.gd" id="2_l5n6p"]
[ext_resource type="Script" path="res://resources/NightConfig.gd" id="3_ho1md"]

[sub_resource type="Resource" id="Resource_wymbl"]
script = ExtResource("1_fmegu")

[sub_resource type="Resource" id="Resource_y5f04"]
script = ExtResource("1_fmegu")
crew_id = "maya"
room = "greenhouse"

[sub_resource type="Resource" id="Resource_d568o"]
script = ExtResource("2_l5n6p")
start_sec = 15.0
peak_sec = 60.0
intensity = 0.5
source_name = "Based on Curiosity rover weather data (simplified)"
why_text = "It's getting very cold outside. Mars nights are colder than any freezer on Earth, so the heater works harder."

[sub_resource type="Resource" id="Resource_5bb1a"]
script = ExtResource("2_l5n6p")
type = "co2"
start_sec = 70.0
peak_sec = 90.0
end_sec = 130.0
intensity = 0.8
why_text = "The fan is slowing and the air feels heavy. The CO2 filter is clogging, so Life Support makes less fresh air."

[resource]
script = ExtResource("3_ho1md")
id = 2
title = "Air and Food"
theme = "Life support and food"
briefing_text = "Maya has joined! Keep the air fresh, and decide if the Crop Lamp is worth the power."
debrief_why = "Making oxygen and growing food both need electricity, and the battery is shared."
debrief_tip = "Turn Life Support up when the air feels heavy, and turn something else down to pay for it."
did_you_know = "NASA's MOXIE experiment on the Perseverance rover made oxygen from the Martian air, and it needed power to do it."
did_you_know_source = "NASA Mars 2020 (MOXIE)"
hazard_events = Array[ExtResource("2_l5n6p")]([SubResource("Resource_d568o"), SubResource("Resource_5bb1a")])
crew_ids = Array[String](["lani", "maya"])
crew_schedule = Array[ExtResource("1_fmegu")]([SubResource("Resource_wymbl"), SubResource("Resource_y5f04")])
visible_meters = Array[String](["oxygen"])
food_enabled = true
unlocked_plots = Array[String](["solar", "battery", "life_support", "greenhouse"])
bonus_goals = Array[String](["battery_20", "food_grew"])
codex_unlocks = Array[String](["co2_oxygen", "food"])
