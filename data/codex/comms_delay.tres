script = ExtResource("1_rfqa6")
id = "comms_delay"
title = "TALKING TO EARTH"
text = "Radio signals take minutes to travel between Mars and Earth. When Perseverance landed on 2021-02-18, its signal took 11 minutes 22 seconds, so it had to land by itself."
real_number = "11 min 22 s (2021-02-18)"
source = "NASA Mars 2020"
order = 8
