script = ExtResource("1_yhvsc")
id = "co2_oxygen"
title = "AIR: CO2 AND OXYGEN"
text = "Mars air is mostly carbon dioxide, which people cannot breathe. NASA's MOXIE experiment on Perseverance made oxygen from that air, using electric power."
source = "NASA Perseverance / MOXIE"
order = 3
