script = ExtResource("1_xllvn")
id = "dust"
title = "DUST STORMS"
text = "Mars has dust storms that can cover the whole planet. In 2018 a global storm blocked so much sunlight that the solar-powered Opportunity rover lost power."
real_number = "Global dust storm, June 2018"
source = "NASA JPL"
order = 2
