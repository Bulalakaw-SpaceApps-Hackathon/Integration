[resource]
script = ExtResource("1_wix4p")
id = "food"
title = "GROWING FOOD ON MARS"
text = "Space greenhouses need grow lights, water, and warmth, and on Mars all three cost battery power. Martian soil also has perchlorate salts, so astronauts grow crops indoors."
real_number = "Continuous LED photoperiods + thermal control"
source = "NASA Veggie & NASA Phoenix (2008)"
order = 4
