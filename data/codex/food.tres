[resource]
script = ExtResource("1_wix4p")
id = "food"
title = "GROWING FOOD ON MARS"
text = "Plants need light, water and warmth, and on a Mars base all three cost power. Martian soil also contains perchlorate, a salt that is bad for people and plants."
source = "NASA (Phoenix lander found perchlorate, 2008)"
order = 4
